# Variables de entorno del servidor LazyForge API

# Puerto (Render lo inyecta automáticamente, este valor es solo para desarrollo local)
PORT=3001

# Token secreto para autenticar requests desde el frontend
# Generá uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET_TOKEN=CAMBIA_ESTO_POR_UN_TOKEN_SECRETO

# Origen permitido (tu GitHub Pages)
ALLOWED_ORIGIN=https://luchidev17.github.io
